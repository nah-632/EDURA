{
  "name": "edura",
  "version": "1.0.0",
  "private": true,
  "description": "Edura - bilingual (Arabic/English) private tutoring marketplace for Bahrain",
  "scripts": {
    "brand:all": "npm run brand:mark && npm run brand:lockup && npm run brand:assets && npm run brand:font",
    "brand:assets": "python3 ../scripts/brand2_assets.py",
    "brand:font": "python3 ../scripts/brand2_fonts.py",
    "brand:lockup": "python3 ../scripts/brand2_lockup.py && python3 ../scripts/make_logo_component.py",
    "brand:mark": "python3 ../scripts/brand2_vectorize.py",
    "build": "npm run typecheck && npm run check:symbols && npm run check:fields && next build",
    "check:client": "node scripts/check-client-boundary.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:fields": "node scripts/check-field-props.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:row-types": "node scripts/check-row-types.mjs",
    "check:symbols": "node scripts/check-new-symbols.mjs",
    "check:syntax": "find src -name '*.ts' -o -name '*.tsx' | xargs esbuild --outdir=.tmp-check --jsx=automatic --log-level=warning",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:seed": "node scripts/seed-reference.mjs",
    "db:seed:demo": "node scripts/seed-reference.mjs --demo",
    "db:seed:remove-demo": "node scripts/seed-reference.mjs --remove-demo",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "test": "node scripts/run-tests.mjs",
    "test:bundle": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.tmp-tests --alias:@=./src --alias:pg=./src/preview/stubs/pg.js && node --test .tmp-tests/*.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "15.0.5",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
