# ============================================================================
# EDURA — environment variables
#
# Copy to `.env.local` for development and add the same keys to the hosting
# provider (Vercel → Project → Settings → Environment Variables) for production.
# Nothing in this file is committed with a value: every secret is supplied by
# the operator.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# Runtime connection: Supabase pooler in TRANSACTION mode (port 6543).
# Serverless functions open and close connections constantly, so they must not
# hold a session.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migrations and seeding need a real session (port 5432): DDL inside a
# transaction-mode pooler cannot complete.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Keep this tiny. Each Vercel instance holds its own pool; 3 is plenty for a
# marketplace at Bahrain scale and prevents connection exhaustion.
DATABASE_POOL_MAX=3

# ---------------------------------------------------------------------------
# Public site (REQUIRED for correct canonical URLs and JSON-LD)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://edura.world

# ---------------------------------------------------------------------------
# Platform contact and payment defaults (REQUIRED)
# These are only the FIRST-BOOT values: once the platform is running, the admin
# console (Settings) is the source of truth and stores them in the database.
# ---------------------------------------------------------------------------
WHATSAPP_TARGET=+97366661238
BENEFITPAY_NUMBER=+97366661238
SUPPORT_EMAIL=support@edura.world
SUPPORT_PHONE=+97366661238

# ---------------------------------------------------------------------------
# Storage (REQUIRED for tutor documents and payment proofs — §21)
# Without these the upload routes answer 501 STORAGE_NOT_CONFIGURED instead of
# pretending to store a file.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
STORAGE_PUBLIC_BUCKET=edura-public
STORAGE_PRIVATE_BUCKET=edura-private

# ---------------------------------------------------------------------------
# Scheduled reminders (§18)
# Protects /api/cron/reminders. Without it the endpoint answers 501 and does
# nothing, because an unauthenticated job endpoint must not run.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`; any other scheduler
# can send `x-cron-secret`.
# ---------------------------------------------------------------------------
CRON_SECRET=<random-32-bytes-base64url>

# ---------------------------------------------------------------------------
# Admin bootstrap (used ONLY by scripts/bootstrap-admin.mjs)
# The script creates the first administrator with TOTP-based MFA enabled and
# prints the secret + otpauth URL. Delete these variables afterwards.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
